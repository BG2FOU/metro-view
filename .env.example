# AMap Web service key. Copy this file to .env.local and fill the value locally.
VITE_AMAP_API_KEY=your_amap_web_api_key

# Use direct with your local Web Key during development. Production must use proxy.
VITE_AMAP_AUTH_MODE=direct
# Development only; this non-VITE value is injected only by the dev server.
AMAP_SECURITY_JS_CODE=your_local_security_js_code
VITE_AMAP_SERVICE_HOST=https://metro.example.com/_AMapService

# Optional JSON time endpoint. Leave empty to use the documented fallback chain.
VITE_TIME_API_URL=
